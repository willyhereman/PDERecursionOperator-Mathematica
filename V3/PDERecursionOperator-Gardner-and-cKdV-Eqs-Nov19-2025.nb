    (2*aaa*alpha*operatorD[0]*u[x, t])/3 + 
    (2*beta*operatorD[0]*u[x, t]^2)/3 + 
    (aaa*alpha*operatorD[-1]*Derivative[1, 0][u][x, t])/3 + 
    (2*beta*operatorD[-1]*operatorD[0]*u[x, t]*
      Derivative[1, 0][u][x, t])/3}}}\
