Cell["\<\
{{{(C[48]*operatorD[4])/2 + 4*C[48]*operatorD[2]*u[x, t] + 
    8*C[48]*operatorD[0]*u[x, t]^2 - 8*C[48]*operatorD[0]*
     v[x, t]^2 + 6*C[48]*operatorD[1]*Derivative[1, 0][u][x, 
      t] + 6*C[48]*operatorD[-1]*u[x, t]*
     Derivative[1, 0][u][x, t] + 2*C[48]*operatorD[-1]*
     operatorD[0]*u[x, t]*Derivative[1, 0][u][x, t] - 
    12*C[48]*operatorD[-1]*v[x, t]*Derivative[1, 0][v][x, 
      t] + 4*C[48]*operatorD[0]*Derivative[2, 0][u][x, t] + 
    C[48]*operatorD[-1]*Derivative[3, 0][u][x, t], 
   -10*C[48]*operatorD[2]*v[x, t] - 8*C[48]*operatorD[0]*
     u[x, t]*v[x, t] - 4*C[48]*operatorD[-1]*operatorD[0]*
     v[x, t]*Derivative[1, 0][u][x, t] - 
    8*C[48]*operatorD[1]*Derivative[1, 0][v][x, t] - 
    2*C[48]*operatorD[0]*Derivative[2, 0][v][x, t]}, 
  {-5*C[48]*operatorD[1]*Derivative[1, 0][v][x, t] - 
    6*C[48]*operatorD[-1]*u[x, t]*Derivative[1, 0][v][x, 
      t] + 2*C[48]*operatorD[-1]*operatorD[0]*u[x, t]*
     Derivative[1, 0][v][x, t] - 6*C[48]*operatorD[0]*
     Derivative[2, 0][v][x, t] - 2*C[48]*operatorD[-1]*
     Derivative[3, 0][v][x, t], -2*C[48]*operatorD[4] - 
    8*C[48]*operatorD[2]*u[x, t] - 8*C[48]*operatorD[0]*
     v[x, t]^2 - 4*C[48]*operatorD[1]*Derivative[1, 0][u][x, 
      t] - 4*C[48]*operatorD[-1]*operatorD[0]*v[x, t]*
     Derivative[1, 0][v][x, t]}}}\
\>", "Output",
